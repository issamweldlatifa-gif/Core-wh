# =============================================================================
# AYROVI Warehouse Core — Phase 0
# Environment template. Copy to `.env` and fill in.
# NEVER commit real secrets. This file contains placeholders only.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ayrovi_warehouse?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS (comma-separated allowed origins) ---
# In dev, set to your Vite frontend origin, e.g. http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

# --- JWT secrets (REQUIRED — generate strong random values in production) ---
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Initial admin (used by `npm run db:seed`) ---
# Leave empty to skip auto-creating the first admin.
INITIAL_ADMIN_CODE=ADMIN001
INITIAL_ADMIN_PASSWORD=ChangeMe!2024

# --- API documentation ---
SWAGGER_ENABLED=true

// AYROVI Warehouse Core — Phase 0
// Prisma schema (PostgreSQL).
//
// IMPORTANT SCOPE GUARD:
// Phase 0 creates ONLY the *core* tables required to stabilise the system:
//   users, roles, permissions, user_roles, role_permissions, sessions,
//   audit_logs, system_settings, api_clients  and  ONE minimal warehouse
//   foundation table (warehouses).
//
// NO operational/workflow tables exist here:
//   NO receiving / stowing / picking / packing / shipping tables.
//   NO inventory movement / container / barcode / OCR tables.
// Those belong to Phase 1+ and are intentionally OUT OF SCOPE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

// The credential mechanism used by a User to authenticate.
enum CredentialMode {
  PASSWORD // a hashed password
  PIN      // a numeric hashed PIN (typical for warehouse floor workers/PDA)
  BOTH     // both are accepted
}

// Lifecycle status of a User account.
enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_LOGOUT_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_STATUS_CHANGED
  USER_ROLES_CHANGED
  USER_PIN_SET
  USER_PASSWORD_CHANGED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_PERMISSIONS_CHANGED
  PERMISSION_UPDATED
  SETTINGS_UPDATED
  API_CLIENT_CREATED
  API_CLIENT_UPDATED
  API_CLIENT_STATUS_CHANGED
  WAREHOUSE_UPDATED
  // Placeholders for later phases (NOT implemented in Phase 0).
  ITEM_RECEIVED
  ITEM_STORED
  ITEM_MOVED
  ITEM_PICKED
  CONTAINER_CREATED
  ORDER_PACKED
  SHIPMENT_DISPATCHED
}

enum ApiClientStatus {
  ACTIVE
  DISABLED
}

// ------------------------------------------------------------------
// Core identity & access model
// ------------------------------------------------------------------

// A User is the primary entity of the system. The employee/access code
// merely IDENTIFIES the user; it is NOT a permission. Permissions are
// defined on Roles, never on the code.
model User {
  id            String         @id @default(uuid())
  name          String
  employeeCode  String         @unique
  email         String?        @unique
  passwordHash  String?        // hashed, NEVER plain text
  pinHash       String?        // hashed numeric PIN, NEVER plain text
  credentialMode CredentialMode @default(PASSWORD)
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions        Session[]
  roles           UserRole[]
  createdAudit    AuditLog[] @relation("Actor")

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, PICKER
  description String?
  isSystem    Boolean  @default(false) // system roles are protected from deletion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "users.manage"
  resource    String   // e.g. "users"
  action      String   // e.g. "manage"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// Join table: User <-> Role (many-to-many)
model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedById String? // who granted the role

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Join table: Role <-> Permission (many-to-many)
model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A session tracks refresh tokens and enables immediate revocation/logout.
model Session {
  id               String        @id @default(uuid())
  userId           String
  refreshTokenHash String        @unique // hashed refresh token
  ipAddress        String?
  userAgent        String?
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  lastSeenAt       DateTime      @default(now())
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("sessions")
}

// ------------------------------------------------------------------
// Audit system (audit-ready from day one)
// ------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  action      AuditAction
  entityType  String?     // e.g. "user", "role"
  entityId    String?     // e.g. the id of the affected entity
  ipAddress   String?
  metadata    Json?       // structured context
  createdAt   DateTime    @default(now())

  actor User? @relation("Actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// Core configuration
// ------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// Placeholder for future external API consumers / machine-to-machine auth.
// Phase 0 provides the schema only; no flows consume it yet.
model ApiClient {
  id               String        @id @default(uuid())
  name             String
  clientId         String        @unique
  clientSecretHash String        // hashed, NEVER plain text
  status           ApiClientStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("api_clients")
}

// ------------------------------------------------------------------
// Warehouse Foundation (minimal, to stabilise the Core)
//
// This is CONFIGURATION about the warehouse being managed, NOT any
// operational workflow. No Receiving/Picking/Packing tables here.
// ------------------------------------------------------------------

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?
  status      String   @default("OPERATIONAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("warehouses")
}

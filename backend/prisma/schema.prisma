// AYROVI Warehouse Core — Phase 0
// Prisma schema (PostgreSQL).
//
// IMPORTANT SCOPE GUARD:
// Phase 0 creates ONLY the *core* tables required to stabilise the system:
//   users, roles, permissions, user_roles, role_permissions, sessions,
//   audit_logs, system_settings, api_clients  and  ONE minimal warehouse
//   foundation table (warehouses).
//
// NO operational/workflow tables exist here:
//   NO receiving / stowing / picking / packing / shipping tables.
//   NO inventory movement / container / barcode / OCR tables.
// Those belong to Phase 1+ and are intentionally OUT OF SCOPE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

// The credential mechanism used by a User to authenticate.
enum CredentialMode {
  PASSWORD // a hashed password
  PIN // a numeric hashed PIN (typical for warehouse floor workers/PDA)
  BOTH // both are accepted
}

// Lifecycle status of a User account.
enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// The application surface a session was opened for. Strict server-side
// Admin / Worker isolation (Order #3): a session carries ONE application and
// the API never lets an ADMIN_WEB session act as a worker context (and vice
// versa). Seeded roles classify the allowed application(s); login enforces it.
enum ApplicationKind {
  ADMIN_WEB
  WORKER_NATIVE
}

// Server truth for which application surface(s) a ROLE may open. Stored on the
// role row so new roles are added from the Admin Web without code changes
// (data-driven, not hard-coded name classification). UNKNOWN = not assigned:
// such a role opens no surface unless a legacy seed-name fallback applies.
enum ApplicationClass {
  ADMIN // opens ADMIN_WEB (management)
  OPERATIONAL // opens WORKER_NATIVE (floor work)
  VIEWER // read-only ADMIN_WEB
  UNKNOWN
}

enum DeviceStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_LOGOUT_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_STATUS_CHANGED
  USER_ROLES_CHANGED
  USER_PIN_SET
  USER_PASSWORD_CHANGED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_PERMISSIONS_CHANGED
  PERMISSION_UPDATED
  SETTINGS_UPDATED
  API_CLIENT_CREATED
  API_CLIENT_UPDATED
  API_CLIENT_STATUS_CHANGED
  WAREHOUSE_UPDATED
  // Phase 1 — physical warehouse structure.
  WAREHOUSE_CREATED
  WAREHOUSE_ACTIVATED
  WAREHOUSE_DEACTIVATED
  ZONE_CREATED
  ZONE_UPDATED
  ZONE_ACTIVATED
  ZONE_DEACTIVATED
  AISLE_CREATED
  AISLE_UPDATED
  AISLE_ACTIVATED
  AISLE_DEACTIVATED
  RACK_CREATED
  RACK_UPDATED
  RACK_ACTIVATED
  RACK_DEACTIVATED
  LEVEL_CREATED
  LEVEL_UPDATED
  LEVEL_ACTIVATED
  LEVEL_DEACTIVATED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_ACTIVATED
  LOCATION_DEACTIVATED
  LOCATION_BLOCKED
  LOCATION_UNBLOCKED
  // Phase 2 — product & order item identity foundation.
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ACTIVATED
  PRODUCT_DEACTIVATED
  WAREHOUSE_ORDER_CREATED
  WAREHOUSE_ORDER_UPDATED
  WAREHOUSE_ORDER_CANCELLED
  ORDER_ITEM_CREATED
  ORDER_ITEM_UPDATED
  ORDER_ITEM_CANCELLED
  PHYSICAL_ITEM_CREATED
  PHYSICAL_ITEM_CANCELLED
  // Expected Arrivals — inbound projection pushed by the AYROVI Arrival CRM.
  // This is NOT physical receiving: the goods are only EXPECTED to arrive.
  CUSTOMER_ARRIVAL_CARD_RECEIVED
  // Shipment Cards — physical shipping/carton data pushed by the AYROVI
  // Arrival CRM (still EXPECTED, not physically received).
  SHIPMENT_CARD_RECEIVED
  // Receiving — physical receipt of the expected shipment/cartons/products.
  RECEIVING_STARTED
  RECEIVING_PAUSED
  RECEIVING_RESUMED
  CARTON_SCANNED
  CARTON_RECEIVED
  CARTON_MANUAL_ENTRY
  UNKNOWN_CARTON
  WRONG_SHIPMENT
  DUPLICATE_CARTON
  PRODUCT_SCANNED
  PRODUCT_RECEIVED
  UNEXPECTED_PRODUCT
  DISCREPANCY_CREATED
  DISCREPANCY_RESOLVED
  RECEIVING_COMPLETED
  RECEIVING_COMPLETED_WITH_DISCREPANCY
  // Receiving card operations (device-side matching rebuild): a completed
  // card (product line or carton) was scanned again and rejected — the
  // operation is logged, nothing is counted twice.
  CARD_ALREADY_COMPLETED
  // WAREHOUSE OS — stations, terminal sessions and audited corrections.
  STATION_CREATED
  STATION_UPDATED
  STATION_STATUS_CHANGED
  STATION_ASSIGNED
  STATION_UNASSIGNED
  CORRECTION_APPLIED
  RECEIVING_REVERSED
  SESSION_REOPENED
  DATA_VOIDED // admin soft-voided an operational record (Data Control)
  DATA_FORCE_DELETED // admin force-deleted data that was ACTIVE in the workflow (Data Control emergency cleanup)
  TASK_ASSIGNED // admin assigned a specific task to a worker (Worker Control)
  TASK_COMPLETED // worker completed an assigned task
  TASK_CANCELLED // admin cancelled an assigned task
  SESSION_REASSIGNED
  // Putaway / stowing — cartons onto real storage locations.
  PUTAWAY_STARTED
  PUTAWAY_PAUSED
  PUTAWAY_RESUMED
  PUTAWAY_COMPLETED
  // Category Master / classification traceability.
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_STATUS_CHANGED
  CATEGORY_MAPPING_SET
  CATEGORY_MAPPING_REMOVED
  CATEGORY_VALIDATED
  CATEGORY_NEEDS_REVIEW
  CATEGORY_MANUALLY_CHANGED
  SORTING_DESTINATION_SELECTED
  // Worker operational model — worker-side issue reporting + assignment lifecycle.
  WORKER_ISSUE_REPORTED
  TASK_IN_PROGRESS
  // Placeholders for later phases (NOT implemented in Phase 0/1).
  ITEM_RECEIVED
  ITEM_STORED
  ITEM_MOVED
  ITEM_PICKED
  CONTAINER_CREATED
  ORDER_PACKED
  SHIPMENT_DISPATCHED
  // Operational containers + article fulfilment flow.
  CONTAINER_READY_FOR_PACKING
  CONTAINER_CLOSED
  ARTICLE_SCANNED
  // Strict Admin/Worker isolation — security events (Doc1 §13, Doc2 §10).
  WORKER_APP_ACCESS_DENIED // an Admin/Viewer session tried a WORKER_NATIVE route
  ADMIN_APP_ACCESS_DENIED // a Worker session tried an ADMIN_WEB route
  UNAUTHORIZED_PERMISSION // an authenticated call missed a required permission
  UNAUTHORIZED_STATION_ACCESS // a worker call referenced an unauthorized station
  DEVICE_REJECTED // a device failed authorization at login / on a request
  SESSION_REVOKED // a session was revoked (user disabled, device revoked, …)
  // Device registry (native worker hardware).
  DEVICE_REGISTERED
  DEVICE_UPDATED
  DEVICE_STATUS_CHANGED
  DEVICE_ASSIGNED
  // Master workflow chain — automatic task dispatch + container staging +
  // customer container QR/lock + shipping verification.
  TASK_AUTO_DISPATCHED // backend auto-generated the next operational task
  CONTAINER_STAGED // a closed tote was moved to a temporary storage station
  CUSTOMER_QR_GENERATED // customer container completed → QR generated
  CUSTOMER_CONTAINER_LOCKED // customer container locked after completion
  CUSTOMER_CONTAINER_REOPENED // admin correction reopened a locked customer container
  SHIPPING_VERIFIED // shipping pre-dispatch verification (customer/container/status)
  EXCEPTION_CREATED // worker-reported operational exception (any stage)
  EXCEPTION_RESOLVED // admin resolved an operational exception
  // ORDER 01 — receiving verification report (Rapport de Confirme).
  REPORT_SUBMITTED // worker submitted the receiving verification report (CONFIRMER ET ENVOYER)
  REPORT_REVIEWED // admin/supervisor reviewed the submitted report
  REPORT_CLOSED // report closed (verification cycle complete)
  DAMAGE_RECORDED // worker declared damaged units on a receiving product line
}

enum ApiClientStatus {
  ACTIVE
  DISABLED
}

// ------------------------------------------------------------------
// Core identity & access model
// ------------------------------------------------------------------

// A User is the primary entity of the system. The employee/access code
// merely IDENTIFIES the user; it is NOT a permission. Permissions are
// defined on Roles, never on the code.
// =====================================================================
// WORKER OPERATIONAL MODEL — the assignment layer is now linked to the
// real operational entities (arrival/carton/container/outbound/order)
// and carries the operational lifecycle below. `relatedType/relatedCode`
// remain as a display-compatible echo of the authoritative FK link
// (and for ad-hoc OTHER references that have no table).
// =====================================================================
enum AssignmentStatus {
  ASSIGNED // admin attached the task to a worker (entry state)
  IN_PROGRESS // the linked workflow session is open
  COMPLETED // linked workflow (or worker) finished it cleanly
  COMPLETED_WITH_DISCREPANCY // finished, but the workflow closed with discrepancies
  BLOCKED // admin/worker flagged it as not executable for now
  CANCELLED // admin cancelled it (kept for audit)
}

model WorkerTaskAssignment {
  id            String           @id @default(uuid())
  workerId      String
  worker        User             @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  title         String
  description   String?
  relatedType   String? // ARRIVAL | SHIPMENT | ORDER | STATION | OTHER (echo of the FK below when one exists)
  relatedCode   String?
  /// Task registry key (receiving | putaway | sorting | order-sorting | packing | shipping).
  taskKey       String?
  status        AssignmentStatus @default(ASSIGNED)
  createdById   String?
  createdBy     User?            @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  note          String? // worker's completion note
  completedById String?
  completedBy   User?            @relation("AssignmentCompleted", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  completedAt   DateTime?
  cancelledById String?
  cancelledBy   User?            @relation("AssignmentCancelled", fields: [cancelledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cancelledAt   DateTime?
  cancelReason  String?

  // ---- authoritative operational-entity links (all optional: an
  // assignment may be a plain instruction with no entity) -----------------
  /// Receiving task → ExpectedArrival (WAR-…).
  arrivalId          String?
  arrival            ExpectedArrival?      @relation("AssignmentArrival", fields: [arrivalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Putaway task → WarehouseCarton (CTN-…).
  cartonId           String?
  carton             WarehouseCarton?      @relation("AssignmentCarton", fields: [cartonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Packing / order-sorting task → OperationalContainer (RCN-/BIN-…).
  containerId        String?
  container          OperationalContainer? @relation("AssignmentContainer", fields: [containerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Shipping task → OutboundShipment (OUT-…).
  outboundShipmentId String?
  outboundShipment   OutboundShipment?     @relation("AssignmentOutbound", fields: [outboundShipmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Order workload → WarehouseOrder.
  orderId            String?
  order              WarehouseOrder?       @relation("AssignmentOrder", fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Where the work should happen, when the admin pinned it.
  stationId          String?
  station            Station?              @relation("AssignmentStation", fields: [stationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId, status])
  @@index([status])
  @@index([taskKey, status])
  @@index([arrivalId])
  @@index([cartonId])
  @@index([containerId])
  @@index([outboundShipmentId])
  @@map("worker_task_assignments")
}

model User {
  id             String         @id @default(uuid())
  name           String
  employeeCode   String         @unique
  email          String?        @unique
  passwordHash   String? // hashed, NEVER plain text
  pinHash        String? // hashed numeric PIN, NEVER plain text
  credentialMode CredentialMode @default(PASSWORD)
  status         UserStatus     @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sessions              Session[]
  devices               Device[]               @relation("DeviceWorker")
  pushTokens            PushToken[]            @relation("UserPushTokens")
  roles                 UserRole[]
  createdAudit          AuditLog[]             @relation("Actor")
  // COMMAND #3 — Worker Control: task assignments.
  workerTaskAssignments WorkerTaskAssignment[] @relation("WorkerAssignments")
  workerTaskCreators    WorkerTaskAssignment[] @relation("AssignmentCreator")
  workerTaskCompletions WorkerTaskAssignment[] @relation("AssignmentCompleted")
  workerTaskCancels     WorkerTaskAssignment[] @relation("AssignmentCancelled")
  // WAREHOUSE OS back-relations.
  stationsAssigned      Station[]              @relation("StationWorker")
  correctionsMade       OperationCorrection[]  @relation("CorrectionAdmin")
  correctionsAbout      OperationCorrection[]  @relation("CorrectionWorker")
  putawaySessions       PutawaySession[]       @relation("PutawayWorker")

  @@index([status])
  @@map("users")
}

model Role {
  id               String           @id @default(uuid())
  name             String           @unique // e.g. SUPER_ADMIN, PICKER
  description      String?
  isSystem         Boolean          @default(false) // system roles are protected from deletion
  // Which application surface(s) this role may open. Data-driven (Doc1 §15,
  // Doc2 §6): the server reads this column; it never classifies by role name.
  applicationClass ApplicationClass @default(UNKNOWN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "users.manage"
  resource    String // e.g. "users"
  action      String // e.g. "manage"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// Join table: User <-> Role (many-to-many)
model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String? // who granted the role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Join table: Role <-> Permission (many-to-many)
model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A session tracks refresh tokens and enables immediate revocation/logout.
// Strict isolation (Doc1 §1/§7, Doc2 §9): every session may carry the
// application surface it was opened for plus — for the native worker app —
// the device and station it was bound to at login. Server truth lives here;
// the client never supplies role/station/device claims on requests.
model Session {
  id               String          @id @default(uuid())
  userId           String
  refreshTokenHash String          @unique // hashed refresh token
  ipAddress        String?
  userAgent        String?
  status           SessionStatus   @default(ACTIVE)
  application      ApplicationKind @default(ADMIN_WEB)
  expiresAt        DateTime
  lastSeenAt       DateTime        @default(now())
  revokedAt        DateTime?
  createdAt        DateTime        @default(now())

  // Native worker binding: the authorized device + assigned station captured
  // at login. Nullable on purpose — admin-web and legacy web-terminal
  // sessions are not device-bound. When set, the JWT strategy re-checks the
  // device/station on every request (revocation is immediate, server-side).
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  stationId String?
  station   Station? @relation("SessionStation", fields: [stationId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([deviceId])
  @@index([stationId])
  @@map("sessions")
}

// ------------------------------------------------------------------
// Device registry — the hardware the native worker app runs on.
// ------------------------------------------------------------------

model Device {
  id          String       @id @default(uuid())
  code        String       @unique // e.g. AYROVI-RCV-01
  name        String
  status      DeviceStatus @default(ACTIVE)
  model       String? // hardware model / label
  appVersion  String? // last known native app version
  stationCode String? // display-only snapshot of the station this device sits at
  lastSeenAt  DateTime?
  lastSeenIp  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignedWorkerId String?
  assignedWorker   User?   @relation("DeviceWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  sessions Session[]
  stations Station[] @relation("StationDevice")

  @@index([status])
  @@index([assignedWorkerId])
  @@map("devices")
}

/// A push registration (FCM/APNs token) belonging to ONE worker's install.
/// Push must reach the phone while the Worker App is closed, so the token is
/// stored server-side against the user rather than kept in app memory.
model PushToken {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String   @default("ANDROID")
  userId     String
  user       User     @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ------------------------------------------------------------------
// Audit system (audit-ready from day one)
// ------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  action      AuditAction
  entityType  String? // e.g. "user", "role"
  entityId    String? // e.g. the id of the affected entity
  ipAddress   String?
  metadata    Json? // structured context
  createdAt   DateTime    @default(now())

  actor User? @relation("Actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// Core configuration
// ------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// Placeholder for future external API consumers / machine-to-machine auth.
// Phase 0 provides the schema only; no flows consume it yet.
model ApiClient {
  id               String          @id @default(uuid())
  name             String
  clientId         String          @unique
  clientSecretHash String // hashed, NEVER plain text
  status           ApiClientStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("api_clients")
}

// ------------------------------------------------------------------
// Phase 1 — Warehouse Foundation & Physical Structure
//
// This models the DIGITAL representation of the PHYSICAL warehouse
// topology ONLY: Warehouse -> Zone -> Aisle -> Rack -> Level -> Location.
//
// SCOPE GUARD:
//   - Multi-warehouse from day one.
//   - NO inventory, NO quantities, NO capacity engine, NO receiving /
//     stowing / picking / packing / shipping workflows, NO containers,
//     NO barcode scanning workflow, NO OCR, NO CRM.
//   - Any future operational module references locations by their
//     stable identifiers (locationCode / barcodeValue), never by mutating
//     this physical structure.
//   - Deactivate rather than delete: all parents use onDelete: Restrict.
// ------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

enum AisleStatus {
  ACTIVE
  INACTIVE
}

enum RackStatus {
  ACTIVE
  INACTIVE
}

enum LevelStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  STORAGE
  RECEIVING
  SORTING
  PACKING
  RETURNS
  QC
  STAGING
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Warehouse {
  id          String          @id @default(uuid())
  code        String          @unique // stable business code, e.g. TUN-MAIN
  name        String
  description String?
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  zones     Zone[]
  locations Location[]
  orders    WarehouseOrder[] // Phase 2: lightweight order projections (nullable warehouseId per D-50)
  stations  Station[]

  @@index([status])
  @@map("warehouses")
}

model Zone {
  id          String     @id @default(uuid())
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  code        String // e.g. SHOES (unique within a warehouse, not globally)
  name        String
  description String?
  status      ZoneStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  aisles           Aisle[]
  locations        Location[]
  categoryMappings CategoryZoneMapping[]
  stations         Station[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([status])
  @@map("zones")
}

model Aisle {
  id          String      @id @default(uuid())
  zoneId      String
  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  code        String // e.g. A01 (unique within a zone)
  name        String
  description String?
  status      AisleStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  racks     Rack[]
  locations Location[]

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([status])
  @@map("aisles")
}

model Rack {
  id          String     @id @default(uuid())
  aisleId     String
  aisle       Aisle      @relation(fields: [aisleId], references: [id], onDelete: Restrict)
  code        String // e.g. R01 (unique within an aisle)
  name        String
  description String?
  status      RackStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  levels    Level[]
  locations Location[]

  @@unique([aisleId, code])
  @@index([aisleId])
  @@index([status])
  @@map("racks")
}

model Level {
  id          String      @id @default(uuid())
  rackId      String
  rack        Rack        @relation(fields: [rackId], references: [id], onDelete: Restrict)
  code        String // e.g. L03 (auto-derived, see D-36)
  levelNumber Int // numeric order: 1,2,3,4...
  status      LevelStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  locations Location[]

  @@unique([rackId, code])
  @@index([rackId])
  @@index([status])
  @@map("levels")
}

model Location {
  id          String    @id @default(uuid())
  // Denormalized warehouseId for multi-warehouse isolation + fast filtering.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  zoneId      String
  zone        Zone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  aisleId     String
  aisle       Aisle     @relation(fields: [aisleId], references: [id], onDelete: Restrict)
  rackId      String
  rack        Rack      @relation(fields: [rackId], references: [id], onDelete: Restrict)
  levelId     String
  level       Level     @relation(fields: [levelId], references: [id], onDelete: Restrict)

  locationCode String  @unique // TUN-MAIN-SHOES-A01-R02-L03 (read-only)
  barcodeValue String  @unique // = locationCode by default (D-33)
  qrValue      String? @unique

  locationType LocationType
  status       LocationStatus @default(ACTIVE)

  // Capacity metadata ONLY — no capacity/counting engine (deferred).
  maxWeight Float?
  maxVolume Float?
  maxUnits  Int?

  physicalItems PhysicalItem[] // Phase 2: nullable currentLocationId on pieces (D-46) — never written by Phase 2
  cartons       WarehouseCarton[] // cartons currently stored here (written by Putaway)
  placements    CartonPlacement[]
  articleUnits  ArticleUnit[] // per-piece storage (written by Sorting/Storage)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([zoneId])
  @@index([aisleId])
  @@index([rackId])
  @@index([levelId])
  @@index([status])
  @@map("locations")
}

// ------------------------------------------------------------------
// Phase 2 — Product & Order Item Identity Foundation
//
// SCOPE GUARD:
//   - Identity + ownership ONLY. NO receiving / stowing / picking /
//     sorting / packing / shipping workflows, NO OCR, NO CRM, NO
//     bulk inventory quantities, NO location assignment.
//   - PhysicalItem is born EXPECTED (D-45). The EXPECTED → RECEIVED
//     transition belongs to Phase 3 (Receiving) and is NOT implemented
//     here. currentLocationId stays NULL until Stowing (D-46).
//   - Deactivate / cancel rather than destroy (D-35): no delete
//     endpoints and no hard delete for any Phase 2 entity.
//   - D-64: top-level external identifiers are normalized at the DTO
//     edge (store / externalProductCode / externalOrderReference /
//     externalCustomerReference = trim + UPPERCASE; per-parent line &
//     item refs = trim-only) so constraints C1–C4 always compare the
//     canonical form.
//   - D-56B + D-65: warehouse_orders.contentHash is a LIVING SHA-256
//     of the canonical SOURCE-OWNED payload (cancelled lines excluded;
//     note/status excluded), recomputed inside the same transaction on
//     every content-affecting mutation.
//   - D-61 (concurrency locking), Cascade-A (cancellation propagation)
//     and D-63 (status gating on creation) are UNRESOLVED — nothing in
//     this schema assumes them.
// ------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

// Provenance of imported records (source-agnostic, mandate §14; D-59).
enum OrderSource {
  ADMIN // created by warehouse staff in the back-office UI
  CRM // pushed by the future CRM integration
  OCR // pushed by the future administration/OCR pipeline (OCR itself is OUT OF SCOPE)
  API // pushed by any other authorized internal integration
}

enum WarehouseOrderStatus {
  OPEN // Phase 2 uses only these two values (D-54)
  CANCELLED // cancelled before/without fulfilment
}

enum OrderItemStatus {
  OPEN
  CANCELLED
}

// Full lifecycle is RESERVED now (Phase 0 precedent A-03) so future
// phases extend behaviour, not the schema shape. Phase 2 may only SET
// EXPECTED (at creation) and CANCELLED. Any other transition is
// rejected with 409 until its dedicated phase implements it (D-47).
enum PhysicalItemStatus {
  EXPECTED // Phase 2 initial state — expected to arrive, NOT received (D-45)
  RECEIVED // reserved — Phase 3 (Receiving)
  STOWED // reserved — future Stowing
  PICKED // reserved — future Picking
  SORTED // reserved — future Sorting
  PACKED // reserved — future Packing
  SHIPPED // reserved — future Shipping
  CANCELLED // expected piece that will never arrive (line/order cancelled)
}

model Product {
  id                  String        @id @default(uuid())
  // D-40/D-44: identity = (store, externalProductCode); normalized trim + UPPERCASE (D-64).
  store               String
  externalProductCode String
  name                String
  productType         String? // free-text category (e.g. "Shoes") — D-48
  description         String?
  // Optional identity-completing attributes (size/color/...). Not a PIM.
  attributes          Json?
  status              ProductStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  orderItems OrderItem[]

  // C1 (D-40/D-44): the SAME external code under TWO stores is NOT the same product.
  @@unique([store, externalProductCode])
  @@index([store])
  @@index([status])
  @@map("products")
}

model WarehouseOrder {
  id                        String               @id @default(uuid())
  // D-41/D-42: lightweight external projection — NO customer record is stored.
  externalOrderReference    String               @unique // C2: idempotency anchor; normalized trim + UPPERCASE (D-64)
  externalCustomerReference String // reference ONLY; normalized trim + UPPERCASE (D-64); non-unique index
  /// Display name of the customer from the CRM card (projection only — still
  /// no local customer master). Kept for customer cards, the customer
  /// container label and bordereau search (Master Order §12/§18).
  customerName              String?
  customerSurname           String?
  source                    OrderSource          @default(ADMIN)
  status                    WarehouseOrderStatus @default(OPEN)
  // D-50: optional at creation; must be set before Receiving (Phase 3 prerequisite).
  warehouseId               String?
  warehouse                 Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  note                      String?
  // D-56B + D-65: living canonical content hash — see schema header comment.
  contentHash               String
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  items             OrderItem[]
  taskAssignments   WorkerTaskAssignment[] @relation("AssignmentOrder")
  // Operational flow back-relations (fulfilment).
  containers        OperationalContainer[]
  articleUnits      ArticleUnit[]
  outboundShipments OutboundShipment[]

  @@index([externalCustomerReference])
  // D-64 projection search fields (created by migration 20260906180000_master_workflow_chain;
  // declared here so the Render boot-gate `prisma migrate diff --exit-code` stays clean).
  @@index([customerName])
  @@index([customerSurname])
  @@index([status])
  @@index([warehouseId])
  @@map("warehouse_orders")
}

model OrderItem {
  id                    String          @id @default(uuid())
  orderId               String
  order                 WarehouseOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId             String
  product               Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  // >= 1 enforced by DTO AND a DB CHECK constraint (C6, raw SQL in migration).
  requestedQuantity     Int
  // D-51: optional source line reference; unique per order when present (C3).
  externalLineReference String?
  note                  String?
  status                OrderItemStatus @default(OPEN)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  physicalItems PhysicalItem[]
  articleUnits  ArticleUnit[]

  // C3: Postgres allows multiple NULLs — lines without refs are not over-constrained (D-51/D-58).
  @@unique([orderId, externalLineReference])
  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@map("order_items")
}

model PhysicalItem {
  id          String    @id @default(uuid()) // THE unique per-piece identity (D-43)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  // D-53: human/barcode display code `PI-XXXXXXXX`, generated server-side,
  // unique + immutable; NOT the PK (D-31).
  itemCode String @unique

  // D-51: optional source piece reference; unique per order item when present (C4).
  externalItemReference String?

  status PhysicalItemStatus @default(EXPECTED) // D-45

  // D-46: NULL until the future Stowing phase assigns a real location.
  // Phase 2 provides NO API that writes this column.
  currentLocationId String?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderItemId, externalItemReference]) // C4 (multiple NULLs allowed)
  @@index([orderItemId])
  @@index([status])
  @@index([currentLocationId])
  @@map("physical_items")
}

// ------------------------------------------------------------------
// Expected Arrivals — inbound projection pushed by the AYROVI Arrival CRM.
//
// SCOPE: a Customer Arrival Card is RECEIVED VIA API and stored as an
// EXPECTED arrival. This is NOT physical receiving: products are NOT on the
// shelf and are NOT counted as inventory. The status lifecycle starts and
// stays at EXPECTED in this phase; the future Receiving phase will move it
// to RECEIVED. No scanner/putaway/picking logic lives here.
// ------------------------------------------------------------------

enum ExpectedArrivalSource {
  ARRIVAL_CRM // pushed by the AYROVI Arrival CRM integration
}

enum ExpectedArrivalStatus {
  EXPECTED // card received via API; goods not physically received yet
  RECEIVING // a receiving session is open and physical cartons are being received
  PAUSED // receiving session paused (no data lost)
  RECEIVED // fully received with no open discrepancies
  RECEIVED_WITH_DISCREPANCY // received but closed with shortages/overages/etc.
  VOIDED // admin voided the arrival card (duplicate / wrong entry) — kept for audit
}

// Shipment card provenance (mirrors the CRM normalized source).
enum ShipmentSourceType {
  MANUAL // employee entered shipping information by hand
  CARRIER_API // pulled via a carrier adapter (DHL/FedEx/...)
  IMPORT // bulk import
  OTHER
}

// Normalized carrier tracking state. Distinct from the internal integration
// status — this is where the package is physically.
enum ShipmentTrackingStatus {
  CREATED
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  UNKNOWN
}

// State of a physical carton master record (created from the Shipment Card).
enum CartonStatus {
  EXPECTED // announced on the shipment, not yet physically received
  RECEIVED // physically received during a Receiving Session
  STORED // put away to a real storage location (Putaway / stowing)
  FLAGGED // worker flagged for review
  WRONG_SHIPMENT // scanned carton belongs to a different shipment
  VOIDED // admin voided the carton record (duplicate / wrong entry) — kept for audit
}

// Receiving Session lifecycle.
enum ReceivingSessionStatus {
  RECEIVING
  PAUSED
  COMPLETED
  COMPLETED_WITH_DISCREPANCY
  CANCELLED
}

// How a carton scan code was presented by the worker.
enum ScanType {
  QR
  BARCODE
  MANUAL
  /// Operator-confirmed text read by the EXISTING OCR review flow (the OCR
  /// engine itself is unchanged; the code is confirmed by the worker).
  OCR
}

// The input device that produced a scan. The receiving workflow is identical
// regardless of source; this only records WHERE the value came from for
// auditing, diagnostics and device analytics.
enum ScanSource {
  CAMERA // built-in / attached camera scan (BarcodeDetector or camera decoder)
  EXTERNAL_SCANNER // Bluetooth / USB / keyboard-wedge scanner
  MANUAL // typed / picked manually
}

// Per-product reconciliation status within a Receiving Session.
enum ReceivingProductStatus {
  EXPECTED // nothing received yet
  PARTIALLY_RECEIVED // some units received
  RECEIVED // expected == received
  SHORT // session closed while received < expected
  OVERAGE // received > expected (supervisor approved)
  UNEXPECTED // SKU not in the Expected Arrival
  NEEDS_REVIEW // cannot be matched reliably (e.g. no SKU)
}

enum DiscrepancyType {
  SHORTAGE
  OVERAGE
  UNKNOWN_CARTON
  WRONG_SHIPMENT
  DUPLICATE_SCAN
  UNEXPECTED_PRODUCT
  MISSING_PRODUCT
  MISSING_CARTON
  IDENTIFICATION_ERROR
  OTHER
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
  REJECTED
}

model ExpectedArrival {
  id                    String                @id @default(uuid())
  // Human/barcode display code `WAR-XXXXXXXX`, generated server-side, unique.
  code                  String                @unique
  // Idempotency anchor: the Customer Arrival Card id from Arrival CRM.
  // One card -> one Expected Arrival, even if the CRM retries the push.
  customerArrivalCardId String                @unique
  arrivalId             String? // external Arrival id (e.g. ARR-JAN-2026-001)
  arrivalReference      String?
  customerId            String // reference/projection only; no local customer row
  customerName          String
  storeId               String?
  storeName             String?
  status                ExpectedArrivalStatus @default(EXPECTED)
  source                ExpectedArrivalSource @default(ARRIVAL_CRM)
  productCount          Int                   @default(0)
  totalUnits            Int                   @default(0)
  // Which API client pushed the card (for traceability; never the secret).
  apiClientId           String?
  idempotencyKey        String?
  receivedViaApi        Boolean               @default(true)
  receivedViaApiAt      DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items             ExpectedArrivalItem[]
  shipments         WarehouseShipment[]
  receivingSessions ReceivingSession[]
  taskAssignments   WorkerTaskAssignment[] @relation("AssignmentArrival")

  @@index([status])
  @@index([customerId])
  @@index([storeId])
  @@index([source])
  @@map("expected_arrivals")
}

model ExpectedArrivalItem {
  id        String          @id @default(uuid())
  arrivalId String
  arrival   ExpectedArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)

  productId            String? // external/CRM product id, reference only
  sku                  String? // store-agnostic: any field may be missing (nullable)
  reference            String?
  productName          String?
  quantity             Int                      @default(1) // >= 1 enforced by DTO + DB CHECK
  variant              String?
  color                String?
  size                 String?
  /// Product category pushed by the Arrival CRM (normalized UPPERCASE, e.g.
  /// "SHOES", "CLOTHING"). NULL when the CRM did not send one — the UI shows
  /// NULL as UNKNOWN; it is NEVER guessed from the product name. Used by
  /// Receiving display and Sorting destination decisions.
  category             String?
  /// Optional subcategory from the CRM (e.g. "SPORTS" under "SHOES").
  subcategory          String?
  /// Who classified the product on the CRM side: AI | MANUAL. Reference only.
  classificationSource String?
  /// Validation verdict against the Category Master at intake time:
  /// CONFIRMED    — category exists in the master and is ACTIVE.
  /// NEEDS_REVIEW — missing / UNCLASSIFIED / unknown / inactive category.
  /// A NEEDS_REVIEW line is NEVER treated as classified downstream.
  categoryStatus       CategoryValidationStatus @default(NEEDS_REVIEW)
  // Store the product came from when a card aggregates multiple stores.
  storeId              String?
  storeName            String?

  // --- CARTON FIX: product inside carton relationship ---
  cartonId String?
  carton   WarehouseCarton? @relation("CartonItems", fields: [cartonId], references: [id], onDelete: SetNull)
  originalPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articleUnits ArticleUnit[] // per-piece provenance back to this expected line

  @@index([arrivalId])
  @@index([sku])
  @@index([category])
  @@index([cartonId])
  @@map("expected_arrival_items")
}

// ------------------------------------------------------------------
// Category Master — the controlled vocabulary for product categories.
// Categories arrive on the CRM Card (AI or MANUAL classified); intake
// validates them against this master. Arbitrary strings NEVER become
// categories. Independent of the physical Warehouse Tree; the optional
// CategoryZoneMapping below links a category to a sorting Zone as pure
// CONFIGURATION (managed at runtime, never hardcoded).
// ------------------------------------------------------------------

/// Verdict of validating a CRM-pushed category against the Category Master.
enum CategoryValidationStatus {
  CONFIRMED
  NEEDS_REVIEW
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model CategoryMaster {
  id            String         @id @default(uuid())
  /// Canonical UPPERCASE code, e.g. SHOES / CLOTHING / ACCESSORIES.
  code          String         @unique
  name          String
  status        CategoryStatus @default(ACTIVE)
  /// Optional allowed subcategories (UPPERCASE codes). Empty = any/none.
  /// Kept as a simple list: subcategories are labels, not a second tree.
  subcategories String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  zoneMappings CategoryZoneMapping[]

  @@index([status])
  @@map("category_master")
}

/// Category -> sorting Zone destination. Warehouse CONFIGURATION, not code:
/// admins manage rows here; sorting reads them. Unique per (category, zone
/// scope) so one category has at most one destination per warehouse.
model CategoryZoneMapping {
  id         String         @id @default(uuid())
  categoryId String
  category   CategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Destination zone. Restrict: a zone referenced by sorting config cannot
  /// be silently deleted from under the workflow.
  zoneId     String
  zone       Zone           @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([categoryId, zoneId])
  @@index([zoneId])
  @@map("category_zone_mappings")
}

// ------------------------------------------------------------------
// OPERATIONAL FLOW — containers, per-piece articles, outbound shipments.
//
// After a carton is opened at Receiving, each scanned piece becomes an
// ArticleUnit: products NEVER go back into the source carton. Articles move
// through configurable OperationalContainers (mixed RECEIVING totes, then
// per-customer BINs) into storage and out through packing/shipping.
// Everything is traceable: Card -> Carton -> Receiving Scan -> Container ->
// Location -> Order -> Bin -> Outbound Shipment -> SHIPPED.
// ------------------------------------------------------------------

enum ContainerType {
  RECEIVING // mixed staging tote used on the receiving line
  CUSTOMER // per-customer/order bin (BIN-xxx -> AHMED)
}

enum ContainerStatus {
  ACTIVE
  READY_FOR_SORTING // receiving tote full (capacity) or manually closed — no longer accepts articles
  READY_FOR_PACKING // customer bin holds every article of its order
  PACKED // contents packed into an outbound shipment
  CLOSED // released after ship / emptied; kept for audit trail
  VOIDED // admin voided the container (wrong / duplicate tote or bin) — kept for audit
}

/// Per-piece lifecycle. An article is born at the receiving scan and is
/// NEVER returned to its source carton.
enum ArticleUnitStatus {
  RECEIVED // scanned out of the carton at receiving
  IN_CONTAINER // sitting in a RECEIVING operational container
  STORED // placed on a warehouse location by sorting/storage
  IN_CUSTOMER_BIN // assigned + physically placed in a customer bin
  PACKED // packed into an outbound shipment carton
  SHIPPED // dispatched
  VOIDED // admin voided the article (wrong / duplicate scan) — kept for audit
}

enum OutboundShipmentStatus {
  READY_TO_SHIP
  SHIPPED
}

/// QR-identified operational container. Configuration-driven (created at
/// runtime by workers/admins), never hardcoded.
model OperationalContainer {
  id       String          @id @default(uuid())
  /// Unique scannable code = the QR value (RCN-xxxxxx / BIN-xxxxxx).
  code     String          @unique
  type     ContainerType
  status   ContainerStatus @default(ACTIVE)
  /// Configurable container capacity (master data, default 50 — never
  /// hardcoded in the UI/API). FULL is derived: articles.count >= capacity.
  capacity Int             @default(50)
  /// Big human label, e.g. the customer reference on a bin ("AHMED").
  label    String?

  /// CUSTOMER bins are attached to one order. SetNull keeps container
  /// history alive even if an order projection is ever removed.
  orderId String?
  order   WarehouseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Customer container QR payload, generated server-side when the bin is
  /// completed (READY_FOR_PACKING) and the card LOCKED (Master Order §15).
  /// Format: `AYROVI:BIN-xxxxxx:ORDER-REF:CUSTOMER-REF`. NULL until complete.
  qrValue String? @unique

  /// Temporary storage (staging) placement of a CLOSED receiving tote
  /// (Master Order §11): which station/zone the container physically waits at.
  /// Written by the container stage operation; SetNull keeps history.
  stagingStationId String?
  stagingStation   Station?  @relation("ContainerStaging", fields: [stagingStationId], references: [id], onDelete: SetNull)
  stagedAt         DateTime?
  stagedById       String? // plain worker id (no FK) — mirrors WarehouseCarton.claimedById

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles          ArticleUnit[]
  outboundShipments OutboundShipment[]
  taskAssignments   WorkerTaskAssignment[] @relation("AssignmentContainer")

  @@index([type, status])
  @@index([orderId])
  // Staging placement lookup (created by migration 20260906180000_master_workflow_chain;
  // declared here so the Render boot-gate `prisma migrate diff --exit-code` stays clean).
  @@index([stagingStationId])
  @@map("operational_containers")
}

/// One physical piece flowing through the warehouse. Born at the receiving
/// scan (source carton + session recorded), then: container -> storage
/// location -> customer bin -> packed -> shipped. All FKs are SetNull-safe
/// so operational history survives upstream cleanups; the audit log keeps
/// the full chain regardless.
model ArticleUnit {
  id   String @id @default(uuid())
  /// Human/QR display code ART-XXXXXXXX, generated server-side, immutable.
  code String @unique

  sku            String
  productName    String?
  category       String?
  subcategory    String?
  categoryStatus CategoryValidationStatus @default(NEEDS_REVIEW)

  status ArticleUnitStatus @default(RECEIVED)

  // --- provenance (receiving) ---
  arrivalItemId      String?
  arrivalItem        ExpectedArrivalItem? @relation(fields: [arrivalItemId], references: [id], onDelete: SetNull)
  receivingSessionId String?
  receivingSession   ReceivingSession?    @relation(fields: [receivingSessionId], references: [id], onDelete: SetNull)
  sourceCartonId     String?
  sourceCarton       WarehouseCarton?     @relation(fields: [sourceCartonId], references: [id], onDelete: SetNull)

  // --- current operational container (tote or customer bin) ---
  containerId String?
  container   OperationalContainer? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  // --- storage ---
  currentLocationId String?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  storedAt          DateTime?

  // --- customer order assignment (set by Order Sorting) ---
  orderId     String?
  order       WarehouseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId String?
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // --- outbound ---
  outboundShipmentId String?
  outboundShipment   OutboundShipment? @relation(fields: [outboundShipmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([status])
  @@index([containerId])
  @@index([currentLocationId])
  @@index([orderId])
  @@index([receivingSessionId])
  @@index([outboundShipmentId])
  @@map("article_units")
}

/// Outbound shipment created at Packing. Carrier integration is an ISOLATED
/// layer: when no carrier adapter is configured the shipment still gets an
/// internal label code and NULL tracking — nothing is invented.
model OutboundShipment {
  id   String @id @default(uuid())
  /// Internal label/QR code OUT-XXXXXX (scannable at the shipping area).
  code String @unique

  orderId String
  order   WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  containerId String?
  container   OperationalContainer? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  status OutboundShipmentStatus @default(READY_TO_SHIP)

  /// Carrier integration outputs — NULL until a real adapter fills them.
  carrier        String?
  trackingNumber String?

  packedBy  String?
  packedAt  DateTime  @default(now())
  shippedBy String?
  shippedAt DateTime?

  articles        ArticleUnit[]
  taskAssignments WorkerTaskAssignment[] @relation("AssignmentOutbound")
  verifications   ShippingVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("outbound_shipments")
}

/// Pre-dispatch verification (Master Order §17): shipping may only be posted
/// after a verification that bound actor + shipment + CONTENT HASH. A
/// verification expires and is single-use; `ship` re-checks the content hash
/// so contents cannot change between verify and dispatch.
model ShippingVerification {
  id                 String           @id @default(uuid())
  outboundShipmentId String
  outboundShipment   OutboundShipment @relation(fields: [outboundShipmentId], references: [id], onDelete: Cascade)

  verifiedById String? // the worker who verified (audited actor)
  /// SHA-256 over the sorted (code|sku) content of the shipment's articles —
  /// recomputed at ship time and compared.
  contentHash  String
  expiresAt    DateTime
  usedAt       DateTime? // set when the dispatch consumed this verification

  createdAt DateTime @default(now())

  @@index([outboundShipmentId])
  @@map("shipping_verifications")
}

/// Worker-reported operational exception for ANY stage (sorting / packing /
/// shipping / container), generalising the receiving-only
/// ReceivingDiscrepancy pattern without duplicating it: receiving keeps its
/// session-scoped discrepancy entity; everything else lands here. One
/// exceptions model, one admin board, audited create/resolve (Master Order
/// §7/§14/§26).
enum OperationalExceptionStatus {
  OPEN
  RESOLVED
  REJECTED
}

model OperationalException {
  id     String                     @id @default(uuid())
  code   String                     @unique // EXC-XXXXXX, server-generated
  /// Same vocabulary as DiscrepancyType (SHORTAGE, MISSING_PRODUCT, ...).
  type   String
  status OperationalExceptionStatus @default(OPEN)

  entityType String // receiving_session | container | article | order | outbound | station | other
  entityId   String?
  entityCode String? // human code (RCN-/ART-/BIN-/OUT-...)
  taskKey    String?

  reason String

  reportedById String?
  stationId    String?
  station      Station? @relation("ExceptionStation", fields: [stationId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@map("operational_exceptions")
}

// ------------------------------------------------------------------
// Inbound Shipments — physical shipping/carton data pushed by the
// AYROVI Arrival CRM Shipment Card. Linked to an Expected Arrival.
// A shipment has one or more cartons. Still EXPECTED until Receiving.
// ------------------------------------------------------------------

model WarehouseShipment {
  id                 String  @id @default(uuid())
  // Human code `WSHP-XXXXXXXX`, generated server-side.
  code               String  @unique
  // Idempotency anchor: the Shipment Card id from Arrival CRM.
  externalShipmentId String  @unique
  shipmentReference  String?
  idempotencyKey     String?

  arrivalId         String? // local ExpectedArrival.id
  expectedArrival   ExpectedArrival? @relation(fields: [arrivalId], references: [id], onDelete: SetNull)
  externalArrivalId String? // external arrival id from CRM
  arrivalReference  String?

  sourceType      ShipmentSourceType @default(MANUAL)
  sourceReference String?

  // Carrier
  carrierId               String?
  carrierName             String?
  carrierCode             String?
  serviceName             String?
  carrierAccountReference String?

  // Tracking — suivi / tracking code preservation (CARTON FIX)
  trackingNumber           String?
  trackingUrl              String?
  trackingStatus           ShipmentTrackingStatus @default(UNKNOWN)
  masterTrackingNumber     String?
  carrierTrackingReference String?
  // Explicit suivi code from external project (preserved as-is)
  suiviCode                String?
  // Original payload preservation (full incoming card)
  originalPayload          Json?
  metadata                 Json?
  sourceProject            String?

  // Sender
  senderName      String?
  senderCompany   String?
  senderCountry   String?
  senderCity      String?
  senderReference String?
  senderAddress   String?
  senderPhone     String?
  senderEmail     String?

  // Destination
  destinationCountry   String?
  destinationCity      String?
  destinationCode      String?
  destinationReference String?

  // Dates (distinct concepts — never one generic date)
  shipmentCreatedAt  DateTime?
  shippedAt          DateTime?
  estimatedArrivalAt DateTime?
  actualArrivalAt    DateTime?

  // Summary counts
  totalCartons  Int @default(0)
  totalProducts Int @default(0)
  totalUnits    Int @default(0)

  // Weight (shipment level, optional)
  totalWeight Float?
  weightUnit  String?

  apiClientId      String?
  receivedViaApi   Boolean   @default(true)
  receivedViaApiAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartons           WarehouseCarton[]
  receivingSessions ReceivingSession[]

  @@index([arrivalId])
  @@index([carrierCode])
  @@index([trackingNumber])
  @@index([trackingStatus])
  @@index([suiviCode])
  @@map("warehouse_shipments")
}

model WarehouseCarton {
  id         String            @id @default(uuid())
  shipmentId String
  shipment   WarehouseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // External identity from the Shipment Card (CTN-...). Unique across warehouse.
  externalCartonId String  @unique
  cartonReference  String?
  qrCodeValue      String? // stable identifier encoded into the QR
  barcodeValue     String? // stable identifier encoded into the barcode
  // --- CARTON FIX: explicit identity preservation ---
  // suivi / tracking code preservation (original from external project)
  suiviCode        String? // suivi_code / tracking_code from external carton card
  trackingCode     String? // alias for tracking_code if different from suivi
  // Entity type discriminator — always CARTON for this entity (clarity)
  entityType       String  @default("CARTON")
  // Original incoming payload (full preservation, never discarded)
  originalPayload  Json?
  metadata         Json?
  sourceProject    String?
  // Product count inside carton (when carton contains products)
  productCount     Int?    @default(0)

  cartonNumber     Int     @default(1)
  totalCartons     Int     @default(1)

  status CartonStatus @default(EXPECTED)

  weight        Float?
  weightUnit    String?
  length        Float?
  width         Float?
  height        Float?
  dimensionUnit String?

  receivedAt DateTime?
  receivedBy String?

  /// Soft putaway claim (C-6): worker currently walking this carton to a
  /// shelf. Ephemeral (service clears it on placement / after a TTL) — kept
  /// as a plain worker id, intentionally not an FK.
  claimedById String?
  claimedAt   DateTime?

  /// Where the carton physically is now. NULL until Putaway stows it (D-46).
  /// Restrict: a location that still holds stock cannot be deleted.
  currentLocationId String?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  storedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivingCartons ReceivingCarton[]
  placements       CartonPlacement[]
  articleUnits     ArticleUnit[] // pieces scanned OUT of this carton at receiving
  taskAssignments  WorkerTaskAssignment[] @relation("AssignmentCarton")
  // CARTON FIX: products inside carton relationship
  arrivalItems     ExpectedArrivalItem[] @relation("CartonItems")

  @@index([shipmentId])
  @@index([status])
  @@index([qrCodeValue])
  @@index([barcodeValue])
  @@index([suiviCode])
  @@index([trackingCode])
  @@index([entityType])
  @@index([currentLocationId])
  @@map("warehouse_cartons")
}

// ------------------------------------------------------------------
// Receiving — physical receipt of an Expected Arrival's shipments.
// EXPECTED data is immutable; receiving records the physical
// observation separately (ReceivingCarton / ReceivingProduct /
// ReceivingDiscrepancy) and never overwrites expected quantities.
// ------------------------------------------------------------------

model ReceivingSession {
  id              String             @id @default(uuid())
  code            String             @unique // RCV-XXXXXXXX
  arrivalId       String
  expectedArrival ExpectedArrival    @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  shipmentId      String? // primary shipment being received
  shipment        WarehouseShipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  status ReceivingSessionStatus @default(RECEIVING)

  // Device context of the worker terminal that started this session (free
  // form, audit/troubleshooting only — hardware is a support layer, not a
  // hard requirement of the workflow).
  deviceType String? // SMARTPHONE | TABLET | DESKTOP | ...
  deviceName String? // browser / device label
  scanSource String? // default scan source chosen by the worker

  startedBy   String?
  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  resumedAt   DateTime?
  completedBy String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartons       ReceivingCarton[]
  scanEvents    ReceivingScanEvent[]
  products      ReceivingProduct[]
  discrepancies ReceivingDiscrepancy[]
  workerLogs    ReceivingWorkerLog[]
  corrections   OperationCorrection[]
  articleUnits  ArticleUnit[] // pieces born in this session
  report        ReceivingReport?
  /// Station the session was executed at (§13). SetNull so retiring a
  /// station never destroys receiving history.
  stationId     String?
  station       Station?               @relation("StationSessions", fields: [stationId], references: [id], onDelete: SetNull)

  @@index([arrivalId])
  @@index([status])
  @@index([stationId])
  @@map("receiving_sessions")
}

model ReceivingCarton {
  id                 String           @id @default(uuid())
  receivingSessionId String
  session            ReceivingSession @relation(fields: [receivingSessionId], references: [id], onDelete: Cascade)
  cartonId           String?
  carton             WarehouseCarton? @relation(fields: [cartonId], references: [id], onDelete: SetNull)

  scannedCode String
  scanType    ScanType   @default(MANUAL)
  source      ScanSource @default(MANUAL) // CAMERA | EXTERNAL_SCANNER | MANUAL
  status      String     @default("RECEIVED") // RECEIVED | UNKNOWN | WRONG_SHIPMENT | DUPLICATE | FLAGGED
  receivedBy  String?
  receivedAt  DateTime?

  // Idempotency: a physical scan operation is processed at most once.
  operationId String? @unique

  createdAt DateTime @default(now())

  @@index([receivingSessionId])
  @@index([cartonId])
  @@map("receiving_cartons")
}

/// Append-only record of EVERY unit-level scan (product receive + article
/// into tote). Guarantees idempotency for receive-product / scan-article:
/// a retried HTTP call with the same client `operationId` is recognised
/// here and NEVER double-counted (fix C-4). Carton scans are already
/// idempotent via `receiving_cartons.operationId`.
model ReceivingScanEvent {
  id        String           @id @default(uuid())
  sessionId String
  session   ReceivingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Client-generated idempotency key (one physical scan = one key).
  operationId String  @unique
  /// PRODUCT (receive-product) | ARTICLE (scan-article into a tote).
  kind        String
  /// The SKU/reference scanned.
  code        String?
  quantity    Int     @default(1)
  source      String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([kind])
  @@map("receiving_scan_events")
}

model ReceivingProduct {
  id                 String           @id @default(uuid())
  receivingSessionId String
  session            ReceivingSession @relation(fields: [receivingSessionId], references: [id], onDelete: Cascade)

  arrivalItemId  String? // link to ExpectedArrivalItem (expected line)
  sku            String?
  reference      String?
  productName    String?
  /// Category snapshot copied from the ExpectedArrivalItem when the session
  /// is seeded (§ CURRENT CARD + CATEGORY). Kept on the receiving line so the
  /// worker terminal and Sorting see it without re-joining CRM data.
  /// NULL = CRM never sent one -> displayed as UNKNOWN, never guessed.
  category       String?
  subcategory    String?
  categoryStatus CategoryValidationStatus @default(NEEDS_REVIEW)

  expectedQuantity Int                    @default(0)
  receivedQuantity Int                    @default(0)
  difference       Int                    @default(0)
  status           ReceivingProductStatus @default(EXPECTED)
  /// ORDER 01 — damaged units declared by the worker on this line (a subset
  /// of the scanned units; confirmed = received - damaged).
  damagedQuantity Int     @default(0)
  damageNote      String?

  reportLines ReceivingReportLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One reconciliation row per expected line per session.
  @@unique([receivingSessionId, sku])
  @@index([receivingSessionId])
  @@index([status])
  @@map("receiving_products")
}

model ReceivingDiscrepancy {
  id                 String           @id @default(uuid())
  receivingSessionId String
  session            ReceivingSession @relation(fields: [receivingSessionId], references: [id], onDelete: Cascade)

  cartonId           String?
  receivingProductId String?
  type               DiscrepancyType
  expectedQuantity   Int?
  actualQuantity     Int?
  difference         Int?
  reason             String?
  status             DiscrepancyStatus @default(OPEN)

  createdBy  String?
  createdAt  DateTime  @default(now())
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?

  @@index([receivingSessionId])
  @@index([status])
  @@index([type])
  @@map("receiving_discrepancies")
}

/// Worker Receiving activity log (Admin "Receiving Worker" report).
///
/// One row per receiving CARD operation executed by a worker on a worker
/// device: the device matches the scanned identifier against the expected
/// card data locally (DEVICE-SIDE MATCHING) and the backend keeps the
/// persistent, auditable record — Who / What / When / Card / Card Type /
/// Operation / Identifier / Result / Duration / Device.
///
/// `result` is the FINAL server-side verdict (the device match is advisory):
///   MATCH     — identifier matched the card, receipt persisted (or confirmed)
///   MISMATCH  — identifier matched no expected card (failure logged, nothing
///               confirmed, nothing completed)
///   DUPLICATE — the card was already completed/received; rejected, not
///               counted again
///   AMBIGUOUS — a shipment-level identifier (tracking number) matched more
///               than one carton card; the worker must scan the specific carton
model ReceivingWorkerLog {
  id                 String           @id @default(uuid())
  receivingSessionId String
  session            ReceivingSession @relation(fields: [receivingSessionId], references: [id], onDelete: Cascade)

  /// Worker who executed the operation (plain id snapshot, no FK: a worker
  /// leaving the system must never destroy receiving history).
  workerId    String?
  workerName  String?
  /// Operational task the operation belongs to (task registry key).
  taskKey     String  @default("receiving")
  /// Display context of the operation (arrival / session codes for the report).
  arrivalCode String?
  sessionCode String?

  /// Which independent card type the operation targets.
  cardType        CardType           @default(PRODUCT)
  /// The expected card the operation references (matched card code, or null
  /// when nothing matched).
  cardRef         String?
  /// The worker operation on the card.
  operation       WorkerLogOperation
  /// How the identifier was read: QR | BARCODE | MANUAL | OCR.
  identifierType  ScanType           @default(MANUAL)
  /// Identifier source device (free form device context, audit only):
  /// CAMERA | EXTERNAL_SCANNER | MANUAL | OCR_CONFIRMED | ...
  source          String             @default("MANUAL")
  /// The (normalized) identifier value the worker scanned / read.
  identifierValue String
  /// Final server-side verdict.
  result          WorkerLogResult
  /// Device-reported scan start (device-side matching start time) and the
  /// server processing time -> duration of the physical operation.
  startedAt       DateTime?
  endedAt         DateTime?
  durationMs      Int?
  /// Device context of the worker terminal (free form, audit only).
  deviceType      String?
  deviceName      String?

  createdAt DateTime @default(now())

  @@index([receivingSessionId])
  @@index([workerId, createdAt])
  @@index([cardType, result])
  @@index([createdAt])
  @@map("receiving_worker_logs")
}

// ORDER 01 — verification vocabulary (§9). Kept SEPARATE from
// ReceivingProductStatus/AssignmentStatus on purpose: those enums are shared
// across stations, while this vocabulary belongs to the receiving
// verification cycle only (mapping layer, no global renames).
enum ReceivingVerificationResult {
  PENDING
  CONFIRMED
  MISSING
  DAMAGED
}

enum ReceivingReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  CLOSED
}

/// ORDER 01 — "Rapport de Confirme": the receiving verification report.
///
/// One report per receiving session. Auto fields are snapshotted at submit
/// time (immutable afterwards); manual fields (description / observation /
/// photos) are filled by the worker. Actor fields are plain snapshots so
/// history survives user/station/device deletions (same philosophy as
/// ReceivingWorkerLog).
model ReceivingReport {
  id                 String               @id @default(uuid())
  receivingSessionId String               @unique
  session            ReceivingSession     @relation(fields: [receivingSessionId], references: [id], onDelete: Cascade)
  status             ReceivingReportStatus @default(DRAFT)

  // --- auto snapshot (computed at submit, immutable afterwards) ---
  expectedProducts  Int @default(0)
  confirmedProducts Int @default(0)
  missingProducts   Int @default(0)
  damagedProducts   Int @default(0)
  expectedUnits     Int @default(0)
  scannedUnits      Int @default(0)
  confirmedUnits    Int @default(0)
  missingUnits      Int @default(0)
  damagedUnits      Int @default(0)
  expectedCartons   Int @default(0)
  receivedCartons   Int @default(0)
  missingCartons    Int @default(0)

  // --- manual (worker) ---
  description String?
  observation String?

  // --- actor snapshot ---
  workerId    String?
  workerName  String?
  stationId   String?
  stationCode String?
  deviceType  String?
  deviceName  String?

  // --- lifecycle ---
  submittedBy String?
  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  closedBy    String?
  closedAt    DateTime?
  /// Next-stage handoff marker: CONFIRMED lines prepared for Temporary
  /// Storage (the physical move itself belongs to the next station).
  handoffReadyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines  ReceivingReportLine[]
  photos ReceivingReportPhoto[]

  @@index([status])
  @@map("receiving_reports")
}

/// ORDER 01 — per-product verification result (snapshot at submit).
model ReceivingReportLine {
  id                 String @id @default(uuid())
  reportId           String
  report             ReceivingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  receivingProductId String?
  receivingProduct   ReceivingProduct? @relation(fields: [receivingProductId], references: [id], onDelete: SetNull)
  sku                String?
  reference          String?
  productName        String?
  expectedQuantity   Int @default(0)
  scannedQuantity    Int @default(0)
  confirmedQuantity  Int @default(0)
  missingQuantity    Int @default(0)
  damagedQuantity    Int @default(0)
  result             ReceivingVerificationResult @default(PENDING)
  note               String?

  @@index([reportId])
  @@index([receivingProductId])
  @@map("receiving_report_lines")
}

/// ORDER 01 — report photos (base64 data URLs: works on CT40/web with no
/// external object storage required).
model ReceivingReportPhoto {
  id      String @id @default(uuid())
  reportId String
  report   ReceivingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Optional receiving-product id this photo documents.
  lineId  String?
  dataUrl String
  caption String?
  takenBy String?
  takenAt DateTime @default(now())

  @@index([reportId])
  @@map("receiving_report_photos")
}

enum CardType {
  PRODUCT
  CARTON
}

enum WorkerLogOperation {
  /// The device matched the identifier against a card and asked for confirm.
  CONFIRM
  /// The device reported a local mismatch (failure logged, no state change).
  SCAN_REJECT
  /// A completed card was scanned again and rejected (never counted twice).
  DUPLICATE_REJECT
}

enum WorkerLogResult {
  MATCH
  MISMATCH
  DUPLICATE
  AMBIGUOUS
}

// ===========================================================================
// WAREHOUSE OS — Stations, Worker Terminal context, and audited Corrections.
// ===========================================================================

/// Operational department a station/task belongs to. Adding a new terminal
/// (Sorting, Putaway, Packing...) means adding a value here + a task handler;
/// the shell, scanner, session and audit layers are reused unchanged (§44).
// ------------------------------------------------------------------
// Putaway (stowing) — move RECEIVED cartons onto real storage locations.
//
// Same integrity philosophy as Receiving: the movement history is an
// append-only ledger (CartonPlacement). Moving a carton a second time does
// NOT rewrite the first record; it closes it (releasedAt) and appends a new
// one, so "where was this carton last Tuesday" stays answerable.
// ------------------------------------------------------------------

enum PutawaySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model PutawaySession {
  id     String               @id @default(uuid())
  code   String               @unique // PUT-000001
  status PutawaySessionStatus @default(ACTIVE)

  workerId String?
  worker   User?   @relation("PutawayWorker", fields: [workerId], references: [id], onDelete: SetNull)

  /// Station the stowing was performed at (§13); SetNull keeps history.
  stationId String?
  station   Station? @relation("StationPutawaySessions", fields: [stationId], references: [id], onDelete: SetNull)

  deviceType String?
  deviceName String?

  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements CartonPlacement[]

  @@index([status])
  @@index([workerId])
  @@index([stationId])
  @@map("putaway_sessions")
}

/// Append-only record of "carton X was placed at location Y".
model CartonPlacement {
  id String @id @default(uuid())

  cartonId String
  carton   WarehouseCarton @relation(fields: [cartonId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  putawaySessionId String?
  session          PutawaySession? @relation(fields: [putawaySessionId], references: [id], onDelete: SetNull)

  /// How the carton and the location codes were captured (audit only).
  cartonSource   ScanSource @default(MANUAL)
  locationSource ScanSource @default(MANUAL)

  placedBy String?
  placedAt DateTime @default(now())

  /// Set when the carton is moved elsewhere. NULL = current location.
  releasedAt DateTime?

  createdAt DateTime @default(now())

  @@index([cartonId])
  @@index([locationId])
  @@index([putawaySessionId])
  @@index([releasedAt])
  @@map("carton_placements")
}

enum StationDepartment {
  RECEIVING
  SORTING
  PUTAWAY
  PACKING
  INVENTORY
  DISPATCH
  /// Temporary storage position for CLOSED receiving totes (Master Order §11):
  /// a full container is moved here and waits for the sorting step.
  STAGING
}

enum StationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// Hardware a station can offer. The workflow never branches on these (§11);
/// they only tell the terminal which input affordances to render.
enum StationCapability {
  CAMERA
  BARCODE_SCANNER
  QR_SCANNER
  OCR
  PRINTER
  SCALE
}

/// A physical work position on the floor (§10).
model Station {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String
  department StationDepartment
  status     StationStatus     @default(ACTIVE)

  /// Currently assigned worker (soft link: clearing the worker must never
  /// delete the station or its history).
  assignedWorkerId String?
  assignedWorker   User?   @relation("StationWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  /// Registered worker device at this position. REAL relation to the Device
  /// registry (C-8) — the column previously held a free-text device code;
  /// the migration maps existing codes to their registry rows.
  deviceId     String?
  device       Device?             @relation("StationDevice", fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  capabilities StationCapability[] @default([])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  /// Zone this physical station sits in (Master Order §11 — the
  /// station/zone relationship is BACKEND/ADMIN CONFIGURATION, not code).
  /// For STAGING stations: the temporary-storage zone closed totes are moved to.
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections      OperationCorrection[]
  sessions         ReceivingSession[]     @relation("StationSessions")
  workerSessions   Session[]              @relation("SessionStation")
  putawaySessions  PutawaySession[]       @relation("StationPutawaySessions")
  taskAssignments  WorkerTaskAssignment[] @relation("AssignmentStation")
  stagedContainers OperationalContainer[] @relation("ContainerStaging")
  exceptions       OperationalException[] @relation("ExceptionStation")

  @@index([department])
  @@index([status])
  @@index([assignedWorkerId])
  @@index([zoneId])
  @@map("stations")
}

/// What an admin is allowed to do to a recorded operation (§7/§39).
enum CorrectionAction {
  REVERSE_RECEIVING
  CORRECT_PRODUCT
  CORRECT_QUANTITY
  REASSIGN_SESSION
  REOPEN_SESSION
  VOID_OPERATION
  RESOLVE_EXCEPTION
  /// Reopen a COMPLETED/LOCKED customer container (READY_FOR_PACKING →
  /// ACTIVE). Authorized admin workflow only — fully audited (Master Order §15).
  REOPEN_CUSTOMER_BIN
}

/// An append-only correction record (§8). Operational history is NEVER
/// overwritten: the original state is snapshotted into `originalSnapshot`
/// and the resulting state into `newSnapshot`, both immutable afterwards.
model OperationCorrection {
  id   String @id @default(uuid())
  code String @unique // COR-XXXXXX

  action CorrectionAction
  /// Free-text justification — mandatory, enforced at the service layer.
  reason String

  /// Who authorised it, and from where.
  adminId   String
  admin     User    @relation("CorrectionAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  ipAddress String?

  /// What was corrected. Kept as loose references so a correction can target
  /// any operational entity without a forest of nullable FKs.
  entityType String // receiving_session | receiving_carton | receiving_product | discrepancy
  entityId   String

  receivingSessionId String?
  session            ReceivingSession? @relation(fields: [receivingSessionId], references: [id], onDelete: SetNull)

  stationId String?
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  workerId String?
  worker   User?   @relation("CorrectionWorker", fields: [workerId], references: [id], onDelete: SetNull)

  /// Immutable before/after snapshots (§8).
  originalSnapshot Json
  newSnapshot      Json

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([receivingSessionId])
  @@index([adminId])
  @@index([createdAt])
  @@map("operation_corrections")
}

# AYROVI Warehouse Core — Frontend (local development)
# Copy to .env and adjust.

# Backend base. In dev, Vite proxies /api to the backend, so a relative base
# works. Set this to the absolute API URL if you serve frontend & backend
# from different origins in production.
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://localhost:3000
